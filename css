/* ===========================
   RESET
=========================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#0d0d0d;
    color:#fff;
    overflow-x:hidden;
}

/* ===========================
   HEADER
=========================== */

header{
    width:100%;
    padding:20px;
    background:#111;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom:3px solid #ff4d00;
    position:sticky;
    top:0;
    z-index:999;
}

.logo{
    font-size:32px;
    color:#ff4d00;
    font-weight:bold;
}

nav a{
    color:white;
    text-decoration:none;
    margin-left:25px;
    transition:.3s;
}

nav a:hover{
    color:#ff4d00;
}

/* ===========================
   HERO
=========================== */

.hero{
    height:400px;
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column;

    background:linear-gradient(rgba(0,0,0,.75),
    rgba(0,0,0,.75)),
    url("assets/background.jpg");

    background-size:cover;
    background-position:center;
}

.hero h1{
    font-size:55px;
    margin-bottom:15px;
}

.hero p{
    color:#ddd;
    font-size:20px;
}

/* ===========================
   PESQUISA
=========================== */

.search-area{
    width:90%;
    max-width:1200px;
    margin:auto;
    display:flex;
    justify-content:center;
    gap:15px;
    margin-top:40px;
    flex-wrap:wrap;
}

.search-area input{

    width:350px;
    padding:15px;

    border:none;
    border-radius:8px;

    outline:none;

    background:#1e1e1e;
    color:white;
}

.search-area select{

    padding:15px;
    border:none;
    outline:none;

    border-radius:8px;

    background:#1e1e1e;
    color:white;
}

/* ===========================
   PERSONAGENS
=========================== */

.container{

    width:90%;
    max-width:1300px;

    margin:50px auto;

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));

    gap:25px;

}

.card{

    background:#181818;

    border-radius:18px;

    overflow:hidden;

    transition:.4s;

    cursor:pointer;

    border:2px solid transparent;

}

.card:hover{

    transform:translateY(-10px);

    border-color:#ff4d00;

    box-shadow:0 0 25px #ff4d0055;

}

.card img{

    width:100%;
    height:320px;

    object-fit:cover;

}

.card-content{

    padding:20px;

}

.card-content h2{

    margin-bottom:10px;

}

.card-content p{

    color:#ddd;

    margin-bottom:10px;

}

/* ===========================
   STATUS
=========================== */

.status{

    margin-top:15px;

}

.status span{

    display:block;

    margin-bottom:8px;

    font-size:14px;

}

.bar{

    width:100%;

    height:12px;

    background:#333;

    border-radius:20px;

    overflow:hidden;

}

.fill{

    height:100%;

    background:linear-gradient(90deg,#ff6a00,#ff0000);

    border-radius:20px;

}

/* ===========================
   BOTÕES
=========================== */

button{

    padding:12px 22px;

    border:none;

    border-radius:8px;

    cursor:pointer;

    background:#ff4d00;

    color:white;

    transition:.3s;

    font-weight:bold;

}

button:hover{

    background:#ff2200;

}

/* ===========================
   FOOTER
=========================== */

footer{

    margin-top:80px;

    padding:30px;

    text-align:center;

    background:#111;

    border-top:2px solid #ff4d00;

}

/* ===========================
   ANIMAÇÃO
=========================== */

.fade{

    animation:fade .8s;

}

@keyframes fade{

    from{

        opacity:0;

        transform:translateY(30px);

    }

    to{

        opacity:1;

        transform:translateY(0);

    }

}

/* ===========================
   RESPONSIVO
=========================== */

@media(max-width:900px){

header{

    flex-direction:column;

}

nav{

    margin-top:15px;

}

.hero h1{

    font-size:38px;

}

.hero p{

    text-align:center;

    padding:0 20px;

}

}

@media(max-width:600px){

.search-area{

    flex-direction:column;

    align-items:center;

}

.search-area input{

    width:100%;

}

.hero{

    height:300px;

}

.hero h1{

    font-size:30px;

}

.logo{

    font-size:25px;

}

.card img{

    height:250px;

}

}