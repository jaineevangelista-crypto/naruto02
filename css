* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #1a1a1a;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}

.card {
    background: #ffffff;
    width: 350px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 20px rgba(255, 102, 0, 0.3);
    border-top: 6px solid #ff6600;
    text-align: center;
}

.card-header {
    padding: 20px;
    background-color: #f9f9f9;
}

.card-header img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 4px solid #ff6600;
    object-fit: cover;
}

.card-header h1 {
    font-size: 24px;
    color: #333;
    margin-top: 10px;
}

.titulo {
    color: #ff6600;
    font-weight: bold;
    font-size: 14px;
}

.card-body {
    padding: 20px;
}

.card-body h3 {
    font-size: 16px;
    color: #555;
    margin-bottom: 8px;
}

.card-body p {
    font-size: 14px;
    color: #666;
    line-height: 1.5;
}

button {
    margin-top: 15px;
    background-color: #ff6600;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    transition: background 0.3s;
}

button:hover {
    background-color: #e65c00;
}

#info-extra {
    margin-top: 15px;
    padding: 10px;
    background-color: #fff3eb;
    border-radius: 6px;
    border: 1px solid #ffccaa;
}

.hidden {
    display: none;
}